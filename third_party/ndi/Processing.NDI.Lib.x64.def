; Export list for Processing.NDI.Lib.x64.dll (Standard NDI 6 SDK): every
; function exported by the NDI 6 DLL that the vendored Standard-SDK headers in
; include/ declare, i.e. the royalty-free API surface. Used only to build a
; stub import library so CI can LINK the plugin without the SDK installed; the
; stub DLL contains no NDI code and is never shipped or loaded.
; Regenerate from a real DLL: python scripts/dump_ndi_exports.py <path-to-dll>
; The .dll extension is load-bearing: the import library records this exact
; string as the DLL to import from, and /DELAYLOAD only matches on string
; equality - without the extension the linker ignores the flag (LNK4199) and
; the NDI import silently reverts to load-time in stub builds.
LIBRARY "Processing.NDI.Lib.x64.dll"
EXPORTS
    NDIlib_destroy
    NDIlib_find_create
    NDIlib_find_create_v2
    NDIlib_find_create2
    NDIlib_find_destroy
    NDIlib_find_get_current_sources
    NDIlib_find_get_sources
    NDIlib_find_wait_for_sources
    NDIlib_framesync_audio_queue_depth
